<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="#02050A">
 <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" app:scaleType="fillCenter"/>
 <View android:id="@+id/cameraDim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#77000000" android:visibility="gone"/>
 <com.jarvis.ai.HudView android:id="@+id/hudOverlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
 <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="4dp">
   <TextView android:id="@+id/status" android:text="● متصل" android:textColor="#64F7D8" android:textSize="12sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/logo" android:text="◈ JARVIS" android:textColor="#62E8FF" android:textStyle="bold" android:textSize="21sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <ImageButton android:id="@+id/menu" android:src="@android:drawable/ic_menu_more" android:contentDescription="منو" android:background="@android:color/transparent" android:tint="#67E7FF" android:layout_width="46dp" android:layout_height="46dp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="7dp">
   <TextView android:id="@+id/mode" android:text="حالت هوشمند • فارسی • صدای فارسی" android:textColor="#A4C7D2" android:textSize="11sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/connection" android:text="AI ●  OFFLINE ●" android:textColor="#64F7D8" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <TextView android:id="@+id/hud" android:text="◉ CORE READY • VISION STANDBY • MEMORY READY" android:textColor="#5EEAFF" android:textSize="10sp" android:padding="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="3dp">
   <TextView android:id="@+id/coreState" android:text="◉ JARVIS CORE" android:textColor="#64E9FF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/offlineState" android:text="آفلاین: آماده" android:textColor="#7BFFB8" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#08131C" android:alpha="0.97" android:padding="10dp">
   <TextView android:id="@+id/chat" android:textColor="#E9FBFF" android:textSize="15sp" android:lineSpacingExtra="3dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true"/>
  </ScrollView>
  <EditText android:id="@+id/input" android:hint="با جارویس صحبت کنید…" android:textColor="#FFFFFF" android:textColorHint="#66828D" android:singleLine="true" android:padding="13dp" android:background="#10202A" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
   <Button android:id="@+id/camera" android:text="👁 دوربین زنده" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/voice" android:text="🎙 ویس" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/send" android:text="➤ ارسال" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
   <Button android:id="@+id/wake" android:text="🎙 Hey JARVIS" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/memory" android:text="🧠 حافظه" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/notifications" android:text="💬 پیام‌ها" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>