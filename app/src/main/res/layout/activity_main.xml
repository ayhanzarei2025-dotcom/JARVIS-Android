<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="#02040A">
 <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" app:scaleType="fillCenter"/>
 <View android:id="@+id/cameraDim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66000000" android:visibility="gone"/>
 <com.jarvis.ai.HudView android:id="@+id/hudOverlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
 <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <ImageButton android:id="@+id/menu" android:src="@android:drawable/ic_menu_more" android:contentDescription="منوی JARVIS" android:background="@android:color/transparent" android:tint="#64F7D8" android:layout_width="48dp" android:layout_height="48dp"/>
   <TextView android:id="@+id/status" android:text="● ONLINE" android:textColor="#64F7D8" android:textSize="11sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="5dp"/>
   <TextView android:id="@+id/logo" android:text="◈ JARVIS 2.01" android:textColor="#62E8FF" android:textStyle="bold" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <TextView android:id="@+id/connection" android:text="NET ●  GPU ●  LOCAL ●" android:textColor="#64F7D8" android:textSize="10sp" android:gravity="center" android:padding="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/mode" android:text="AUTO • فارسی • ویس فارسی • نوشته فارسی" android:textColor="#A4C7D2" android:textSize="11sp" android:padding="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/hud" android:text="◉ CORE READY • VISION STANDBY • MEMORY READY" android:textColor="#5EEAFF" android:textSize="10sp" android:padding="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="3dp">
   <TextView android:id="@+id/coreState" android:text="◉ JARVIS CORE" android:textColor="#64E9FF" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/offlineState" android:text="LOCAL: آماده" android:textColor="#7BFFB8" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#07121B" android:alpha="0.96" android:padding="12dp">
   <TextView android:id="@+id/chat" android:textColor="#E9FBFF" android:textSize="15sp" android:lineSpacingExtra="3dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true"/>
  </ScrollView>
  <EditText android:id="@+id/input" android:hint="با JARVIS صحبت کنید…" android:textColor="#FFFFFF" android:textColorHint="#66828D" android:singleLine="true" android:padding="13dp" android:background="#10202A" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
   <Button android:id="@+id/camera" android:text="👁 Live Camera" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/voice" android:text="🎙 Voice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/send" android:text="➤ Send" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
   <Button android:id="@+id/wake" android:text="🎙 Hey JARVIS" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/memory" android:text="🧠 Memory" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <Button android:id="@+id/notifications" android:text="💬 Messages" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>