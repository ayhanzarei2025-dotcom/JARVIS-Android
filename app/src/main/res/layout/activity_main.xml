<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#02070b">
    <SurfaceView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    <View android:id="@+id/cameraDim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#33000000" android:visibility="gone" />
    <com.jarvis.ai.HudView android:id="@+id/hudOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/status" android:text="CORE ONLINE" android:textColor="#8cecff" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <Button android:id="@+id/camera" android:text="HUD" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/hud" android:text="◉ JARVIS / READY" android:textColor="#62dfff" android:textSize="11sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="5dp"/>
        <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#091016" android:alpha="0.94" android:padding="10dp">
            <TextView android:id="@+id/chat" android:textColor="#d7e8e8" android:textSize="15sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true"/>
        </ScrollView>
        <EditText android:id="@+id/input" android:hint="Ask JARVIS..." android:textColor="#ffffff" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/voice" android:text="VOICE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <Button android:id="@+id/send" android:text="EXECUTE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <Button android:id="@+id/stop" android:text="STOP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/permissions" android:text="PERMS" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/notifications" android:text="NOTIFY" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/briefing" android:text="BRIEF" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/settings" android:text="AI SETUP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <Button android:id="@+id/memory" android:text="MEMORY" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <Button android:id="@+id/capture" android:text="CAPTURE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
