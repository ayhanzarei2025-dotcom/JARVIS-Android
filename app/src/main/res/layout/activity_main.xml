<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#02070b">
 <SurfaceView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="280dp" android:layout_gravity="top" android:visibility="gone"/>
 <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:id="@+id/status" android:textColor="#8cecff" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/camera" android:text="VISION" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
  <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#091016" android:padding="10dp"><TextView android:id="@+id/chat" android:textColor="#d7e8e8" android:textSize="15sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true"/></ScrollView>
  <EditText android:id="@+id/input" android:hint="Ask JARVIS..." android:textColor="#ffffff" android:hintTextColor="#66777d" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/voice" android:text="HEY JARVIS" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/send" android:text="EXECUTE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/stop" android:text="STOP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/></LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/permissions" android:text="PERMS" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/notifications" android:text="NOTIFY" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/briefing" android:text="BRIEF" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/settings" android:text="AI SETUP" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/memory" android:text="MEMORY" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/capture" android:text="ANALYZE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/></LinearLayout>
 </LinearLayout></FrameLayout>